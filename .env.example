# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
# Also add this loopback URI to the same Google OAuth Web client when using Pub/Sub.
GOOGLE_PUBSUB_REDIRECT_URI=http://127.0.0.1:3000/auth/google/pubsub/callback

# Generate with: bun -e 'import { randomBytes } from "node:crypto"; console.log(randomBytes(32).toString("hex"))'
# Keep this key private and stable; losing it makes stored OAuth tokens unreadable.
OAUTH_ENCRYPTION_KEY=

HOST=127.0.0.1
PORT=3000
REGISTRY_DB_PATH=./data/registry.sqlite
ACCOUNT_DATA_DIRECTORY=./data/accounts

# Optional Gmail notification ingestion. Configure the topic/subscription and IAM in Google Cloud;
# set all three together. The Pub/Sub account is authorized from the local browser setup page.
# Topic and subscription are short IDs, not full projects/... resource names.
GCP_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
REDIS_URL=redis://127.0.0.1:6379
